<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mobile_toolbar"
        style="@style/Widget.SmartTube.Mobile.Toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/mobile_top_bar_height"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/mobile_native_settings" />

    <!--
      Video EXP landscape override.
      Car displays are typically wide but short. In the shared Music layout the action
      buttons live outside the RecyclerView, so lower actions can fall below the visible
      viewport. Keep Music untouched and let the whole Video EXP settings body scroll.
    -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mobile_video_settings_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:focusable="true"
        android:scrollbars="vertical"
        android:paddingStart="@dimen/mobile_screen_horizontal_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/mobile_screen_horizontal_padding"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="afterDescendants"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_android_auto_button"
                style="@style/Widget.SmartTube.Mobile.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/mobile_aa_settings_entry" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_player_settings_button"
                style="@style/Widget.SmartTube.Mobile.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/mobile_player_settings_entry" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_radio_button"
                style="@style/Widget.SmartTube.Mobile.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/mobile_radio_settings_entry" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_offline_button"
                style="@style/Widget.SmartTube.Mobile.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/mobile_offline_entry" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_diagnostics_button"
                style="@style/Widget.SmartTube.Mobile.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/mobile_diagnostics_entry" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_classic_button"
                style="@style/Widget.SmartTube.Mobile.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/mobile_native_classic"
                app:icon="@drawable/mobile_ic_back_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_update_button"
                style="@style/Widget.SmartTube.Mobile.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/mobile_update_check" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/mobile_disable_startup_update_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/mobile_update_disable_startup" />

            <!--
              The shared fragment still owns this RecyclerView and adapter. Disable its
              nested scrolling so focus/touch/rotary movement scrolls the outer car-safe
              container instead of trapping input inside a second scrolling surface.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mobile_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:minHeight="160dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />

            <LinearLayout
                android:id="@+id/mobile_state_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ProgressBar
                    android:id="@+id/mobile_progress"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mobile_error"
                    style="@style/TextAppearance.SmartTube.Mobile.BodyLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mobile_retry_button"
                    style="@style/Widget.SmartTube.Mobile.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:text="@string/mobile_native_retry"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
