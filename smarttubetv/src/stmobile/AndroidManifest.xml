<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <intent>
            <action android:name="android.settings.ANDROID_AUTO_SETTINGS" />
        </intent>
        <intent>
            <action android:name="com.google.android.projection.gearhead.SETTINGS" />
        </intent>
    </queries>

    <!-- Background playback and its user-visible MediaStyle notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Mobile APK: Android TV is no longer an installation requirement. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false"
        tools:node="replace" />

    <!-- This flavor is intended for phones/tablets and requires direct touch. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true"
        tools:node="replace" />

    <!-- Both orientations are supported; individual activities choose policy. -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <application
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        tools:replace="android:label,android:resizeableActivity,android:supportsRtl">

        <!-- Phone launcher. Retain normal LAUNCHER from main manifest and remove TV launcher. -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivity"
            android:screenOrientation="fullUser"
            tools:replace="android:screenOrientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category
                    android:name="android.intent.category.LEANBACK_LAUNCHER"
                    tools:node="remove" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivityAlt"
            android:targetActivity="com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category
                    android:name="android.intent.category.LEANBACK_LAUNCHER"
                    tools:node="remove" />
            </intent-filter>
        </activity-alias>

        <!-- Leanback-free preview host for Part 5. It is not a launcher yet. -->
        <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.mobile.nativeui.host.MobileNativeActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:screenOrientation="fullUser"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.SmartTube.MobileNative"
            tools:replace="android:launchMode,android:resizeableActivity,android:supportsPictureInPicture" />

        <service
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.mobile.nativeui.background.MobileBackgroundPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- Browsing/settings may follow the phone/tablet orientation. -->
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.dialogs.AppDialogActivity"
                  android:screenOrientation="fullUser"
                  tools:replace="android:screenOrientation" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.dialogs.AppDialogActivityOpaque"
                  android:screenOrientation="fullUser"
                  tools:replace="android:screenOrientation" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.browse.BrowseActivity"
                  android:screenOrientation="fullUser"
                  tools:replace="android:screenOrientation" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.channel.ChannelActivity"
                  android:screenOrientation="fullUser"
                  tools:replace="android:screenOrientation" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.channeluploads.ChannelUploadsActivity"
                  android:screenOrientation="fullUser"
                  tools:replace="android:screenOrientation" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.search.tags.SearchTagsActivity"
                  android:screenOrientation="fullUser"
                  tools:replace="android:screenOrientation" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.signin.SignInActivity"
                    android:screenOrientation="fullUser"
                    android:theme="@style/Theme.SmartTube.MobileNative"
                    tools:replace="android:screenOrientation,android:theme" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.adddevice.AddDeviceActivity"
                  android:screenOrientation="fullUser"
                  tools:replace="android:screenOrientation" />
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.webbrowser.WebBrowserActivity"
                  android:screenOrientation="fullUser"
                  tools:replace="android:screenOrientation" />

        <!-- Player may rotate between portrait and landscape without recreation;
             the upstream configChanges list handles the configuration event. -->
        <activity android:name="com.liskovsoft.smartyoutubetv2.tv.ui.playback.PlaybackActivity"
                  android:screenOrientation="fullSensor"
                  android:resizeableActivity="true"
                  android:supportsPictureInPicture="true"
                  tools:replace="android:screenOrientation,android:resizeableActivity,android:supportsPictureInPicture" />

        <!-- P13-AA1: Android Auto media application. -->
        <service
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.mobile.automotive.SmartTubeAutoMusicService"
            android:exported="true"
            android:label="@string/aa_app_name"
            android:icon="@mipmap/app_icon">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="androidx.car.app.TintableAttributionIcon"
            android:resource="@drawable/mobile_ic_notification" />
            <activity
            android:name="com.liskovsoft.smartyoutubetv2.tv.ui.mobile.automotive.SmartTubeAutoMusicPlayerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar" />
    </application>
</manifest>
