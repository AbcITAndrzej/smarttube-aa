<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/mobile_surface_variant"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/mobile_aa_playlist_title"
            style="@style/TextAppearance.SmartTube.Mobile.TitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/mobile_aa_playlist_summary"
            style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/mobile_aa_playlist_visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/mobile_aa_playlist_visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_aa_playlist_up"
                style="@style/Widget.SmartTube.Mobile.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/mobile_aa_playlist_up" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_aa_playlist_down"
                style="@style/Widget.SmartTube.Mobile.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/mobile_aa_playlist_down" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
