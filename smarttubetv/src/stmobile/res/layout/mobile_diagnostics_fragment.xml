<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mobile_toolbar"
        style="@style/Widget.SmartTube.Mobile.Toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/mobile_top_bar_height"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/mobile_diagnostics_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/mobile_screen_horizontal_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/mobile_screen_horizontal_padding"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_toolbar"
        app:layout_constraintWidth_max="@dimen/mobile_settings_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/mobile_diagnostics_summary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile_diagnostics_flags_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/mobile_diagnostics_flags_summary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_capture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_diagnostics_capture" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_recent_events"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_diagnostics_recent_events" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/mobile_paging_flags_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/mobile_paging_flags_summary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_paging_search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_paging_search" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_paging_channel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_paging_channel" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_paging_radio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_paging_radio" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/mobile_smart_player_flags_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/mobile_smart_player_flags_summary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_smart_player"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_smart_player_master" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/mobile_radio2_flags_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/mobile_radio2_flags_summary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_radio2_master"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_radio2_master" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_radio2_search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_radio2_remote_search" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_radio2_failover"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_radio2_failover" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_radio2_aa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_radio2_android_auto" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/mobile_offline_flags_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/mobile_offline_flags_summary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_offline_foundation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_master_flag" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_offline_listen_save"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_listen_flag" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_offline_playlists"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_playlists_flag" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_offline_android_auto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_android_auto_flag" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_offline_trip_reserve"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_trip_flag" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/mobile_media3_flags_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/mobile_media3_flags_summary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_media3_master"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_media3_master_flag" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_media3_radio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_media3_radio_flag" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_media3_offline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_media3_offline_flag" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_media3_fallback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_media3_fallback_flag" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/mobile_performance_flags_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/mobile_performance_flags_summary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_performance_monitor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_performance_monitor_flag" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_diagnostics_performance_frames"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_performance_frames_flag" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mobile_diagnostics_refresh"
                    style="@style/Widget.SmartTube.Mobile.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/mobile_diagnostics_refresh" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mobile_diagnostics_copy"
                    style="@style/Widget.SmartTube.Mobile.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/mobile_diagnostics_copy" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_outline"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/mobile_diagnostics_report"
                    style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textIsSelectable="true"
                    android:typeface="monospace" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_diagnostics_reset"
                style="@style/Widget.SmartTube.Mobile.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/mobile_diagnostics_reset" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
