<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_native_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/mobile_native_fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/mobile_bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/mobile_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/mobile_bottom_nav_height"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:minHeight="48dp"
        app:itemIconSize="@dimen/mobile_bottom_nav_icon_size"
        app:itemRippleColor="?attr/colorControlHighlight"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/mobile_native_bottom_navigation" />

</androidx.constraintlayout.widget.ConstraintLayout>
