<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mobile_toolbar"
        style="@style/Widget.SmartTube.Mobile.Toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/mobile_top_bar_height"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:logo="@mipmap/app_icon"
        app:menu="@menu/mobile_native_home_toolbar"
        app:title="SmartTube" />

    <HorizontalScrollView
        android:id="@+id/mobile_category_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_toolbar">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/mobile_category_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            app:chipSpacingHorizontal="6dp"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mobile_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="@dimen/mobile_screen_horizontal_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/mobile_screen_horizontal_padding"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_category_scroll"
        app:layout_constraintWidth_max="@dimen/mobile_content_max_width" />

    <LinearLayout
        android:id="@+id/mobile_state_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_category_scroll"
        app:layout_constraintWidth_max="480dp">

        <ProgressBar
            android:id="@+id/mobile_progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mobile_error"
            style="@style/TextAppearance.SmartTube.Mobile.BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="12dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mobile_retry_button"
            style="@style/Widget.SmartTube.Mobile.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/mobile_native_retry"
            android:visibility="gone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
