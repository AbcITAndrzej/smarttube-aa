<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/mobile_player_surface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/mobile_native_video_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/mobile_progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/mobile_player_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/mobile_player_controls_background"
        android:orientation="vertical"
        android:paddingStart="@dimen/mobile_screen_horizontal_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/mobile_screen_horizontal_padding"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_back_button"
                style="@style/Widget.SmartTube.Mobile.PlayerIconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/mobile_native_back"
                android:minWidth="48dp"
                android:minHeight="48dp"
                app:icon="@drawable/mobile_ic_back_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <TextView
                android:id="@+id/mobile_player_title"
                style="@style/TextAppearance.SmartTube.Mobile.PlayerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:paddingStart="8dp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/mobile_player_seek"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <TextView
            android:id="@+id/mobile_player_time"
            style="@style/TextAppearance.SmartTube.Mobile.PlayerTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="24dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mobile_player_rewind"
                    style="@style/Widget.SmartTube.Mobile.PlayerButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="64dp"
                    android:minHeight="48dp"
                    android:text="@string/mobile_native_rewind_10" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mobile_player_play"
                    style="@style/Widget.SmartTube.Mobile.PlayerButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="88dp"
                    android:minHeight="48dp"
                    android:text="@string/mobile_native_play" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mobile_player_forward"
                    style="@style/Widget.SmartTube.Mobile.PlayerButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="64dp"
                    android:minHeight="48dp"
                    android:text="@string/mobile_native_forward_10" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mobile_player_audio"
                    style="@style/Widget.SmartTube.Mobile.PlayerButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="80dp"
                    android:minHeight="48dp"
                    android:text="@string/mobile_native_audio" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mobile_player_subtitles"
                    style="@style/Widget.SmartTube.Mobile.PlayerButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="80dp"
                    android:minHeight="48dp"
                    android:text="@string/mobile_native_subtitles" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
