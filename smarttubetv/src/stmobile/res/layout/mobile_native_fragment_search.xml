<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mobile_toolbar"
        style="@style/Widget.SmartTube.Mobile.Toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/mobile_top_bar_height"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/mobile_native_search" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/mobile_search_input_layout"
        style="@style/Widget.SmartTube.Mobile.SearchInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/mobile_screen_horizontal_padding"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:hint="@string/mobile_native_search_hint"
        app:boxBackgroundMode="outline"
        app:layout_constraintEnd_toStartOf="@id/mobile_search_submit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_toolbar">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/mobile_search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="48dp"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mobile_search_submit"
        style="@style/Widget.SmartTube.Mobile.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="@dimen/mobile_screen_horizontal_padding"
        android:contentDescription="@string/mobile_native_search"
        android:minWidth="48dp"
        android:minHeight="48dp"
        app:icon="@drawable/mobile_ic_search_24"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:layout_constraintBottom_toBottomOf="@id/mobile_search_input_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/mobile_search_input_layout" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mobile_suggestions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/mobile_screen_horizontal_padding"
        android:paddingEnd="@dimen/mobile_screen_horizontal_padding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_search_input_layout"
        app:layout_constraintWidth_max="@dimen/mobile_content_max_width" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mobile_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/mobile_screen_horizontal_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/mobile_screen_horizontal_padding"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_suggestions"
        app:layout_constraintWidth_max="@dimen/mobile_content_max_width" />

    <LinearLayout
        android:id="@+id/mobile_state_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_suggestions"
        app:layout_constraintWidth_max="480dp">

        <ProgressBar
            android:id="@+id/mobile_progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mobile_error"
            style="@style/TextAppearance.SmartTube.Mobile.BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="12dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mobile_retry_button"
            style="@style/Widget.SmartTube.Mobile.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/mobile_native_retry"
            android:visibility="gone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
