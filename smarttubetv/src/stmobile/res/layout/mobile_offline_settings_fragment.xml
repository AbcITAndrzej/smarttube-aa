<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mobile_toolbar"
        style="@style/Widget.SmartTube.Mobile.Toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/mobile_top_bar_height"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/mobile_offline_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/mobile_screen_horizontal_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/mobile_screen_horizontal_padding"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile_offline_foundation_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/mobile_offline_foundation_summary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_offline_foundation_enabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_foundation_enabled" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_offline_auto_cleanup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_auto_cleanup" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_offline_storage_limit"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_offline_free_reserve"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile_offline_listen_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/mobile_offline_listen_summary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_offline_listen_enabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_listen_enabled" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_offline_listen_mode"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_offline_listen_wifi_only"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_listen_wifi_only" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_offline_listen_complete_after_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_listen_complete_after_switch" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_offline_listen_threshold"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_offline_listen_recent_limit"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_offline_manage_listen_saved"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_manage_listen_saved" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile_offline_playlists_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/mobile_offline_playlists_summary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_offline_playlist_downloads_enabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_playlist_downloads_enabled" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_offline_playlist_wifi_only"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_playlist_wifi_only" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_offline_manage_playlists"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_manage_playlists" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile_offline_trip_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/mobile_offline_trip_summary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_offline_trip_enabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_trip_enabled" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_offline_trip_wifi_only"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_trip_wifi_only" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_offline_trip_favorites_enabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_trip_favorites_enabled" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_offline_trip_recent_count"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_offline_trip_favorite_count"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_offline_trip_playlist_count"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_offline_trip_playlist_track_limit"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_offline_trip_prepare_now"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_trip_prepare_now" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile_offline_storage_section" />

                    <TextView
                        android:id="@+id/mobile_offline_status"
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textIsSelectable="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_offline_cleanup_now"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_cleanup_now" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_offline_clear_all"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/mobile_offline_clear_all" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
