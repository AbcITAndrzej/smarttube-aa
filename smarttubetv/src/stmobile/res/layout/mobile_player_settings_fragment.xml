<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mobile_toolbar"
        style="@style/Widget.SmartTube.Mobile.Toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/mobile_top_bar_height"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/mobile_player_settings_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/mobile_screen_horizontal_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/mobile_screen_horizontal_padding"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_toolbar"
        app:layout_constraintWidth_max="@dimen/mobile_settings_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/mobile_player_settings_summary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile_player_language_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/mobile_player_language_summary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_player_pref_audio_language"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_default_audio" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_player_pref_subtitle_language"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_default_subtitles" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile_subtitle_appearance_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/mobile_subtitle_appearance_summary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_player_pref_subtitle_appearance"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="@string/mobile_subtitle_appearance_title" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_player_pref_subtitle_reset"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="@string/mobile_subtitle_reset" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile_player_gestures_section" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_auto_hide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_auto_hide" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_pinch_zoom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_pinch_zoom" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_double_tap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_double_tap_seek" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_swipe_seek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_swipe_seek" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mobile_player_pref_double_tap_interval"
                        style="@style/Widget.SmartTube.Mobile.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_double_tap_interval_title" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_brightness_gesture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_brightness_gesture" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_volume_gesture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_volume_gesture" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile_player_smart_ux_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/mobile_player_smart_ux_summary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_screen_lock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_screen_lock" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_sleep_timer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_sleep_timer" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_remember_zoom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_remember_zoom" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_smart_fit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_smart_fit" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile_player_controls_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/mobile_player_controls_summary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_previous_next"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_show_previous_next" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_quick_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_show_quick_options" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_subtitles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_show_subtitles" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_audio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_show_audio" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_quality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_show_quality" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_speed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_show_speed" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_fit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_show_fit" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_pip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_show_pip" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_fullscreen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_show_fullscreen" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_more"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_show_more" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile_player_instant_play_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/mobile_player_instant_play_summary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_instant_play"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_instant_play" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_instant_403_recovery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_instant_403_recovery" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_startup_watchdog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_startup_watchdog" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/mobile_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.TitleLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mobile_player_enhancements_section" />

                    <TextView
                        style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/mobile_player_enhancements_summary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_sponsorblock_markers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_sponsorblock_markers" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_dearrow_native_lists"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_dearrow_native_lists" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_original_titles_native_lists"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_original_titles_native_lists" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/mobile_player_pref_fallback_thumbnails_native_lists"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mobile_player_fallback_thumbnails_native_lists" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_player_pref_reset"
                style="@style/Widget.SmartTube.Mobile.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/mobile_player_reset" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
