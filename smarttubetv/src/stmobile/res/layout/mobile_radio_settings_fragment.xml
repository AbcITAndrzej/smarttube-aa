<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mobile_toolbar"
        style="@style/Widget.SmartTube.Mobile.Toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/mobile_top_bar_height"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/mobile_radio_title" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mobile_radio_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_toolbar"
        app:layout_constraintWidth_max="@dimen/mobile_settings_max_width"
        app:strokeColor="@color/mobile_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mobile_radio_summary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mobile_radio_sync"
                    style="@style/Widget.SmartTube.Mobile.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:text="@string/mobile_radio_sync" />

                <ProgressBar
                    android:id="@+id/mobile_radio_progress"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/mobile_radio_search_layout"
                style="@style/Widget.SmartTube.Mobile.SearchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/mobile_radio_search_hint"
                app:boxBackgroundMode="outline"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/mobile_radio_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="44dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/mobile_radio_collection"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/mobile_radio_collection_label" />

                <Spinner
                    android:id="@+id/mobile_radio_sort"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/mobile_radio_sort_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mobile_radio_country_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/mobile_radio_country"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:contentDescription="@string/mobile_radio_country_filter" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mobile_radio_tag_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/mobile_radio_tag"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:contentDescription="@string/mobile_radio_genre_filter" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/mobile_radio_timeshift_enabled"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:text="@string/mobile_radio_timeshift_enabled" />

                <Spinner
                    android:id="@+id/mobile_radio_timeshift_duration"
                    android:layout_width="100dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/mobile_radio_timeshift_duration" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_radio_advanced_toggle"
                style="@style/Widget.SmartTube.Mobile.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/mobile_radio_advanced_options" />

            <LinearLayout
                android:id="@+id/mobile_radio_advanced_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/mobile_radio_server_search_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/mobile_radio_server_search_enabled" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/mobile_radio_recent_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/mobile_radio_recent_enabled" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/mobile_radio_failover_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/mobile_radio_failover_enabled" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/mobile_radio_categories_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/mobile_radio_categories_enabled" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/mobile_radio_aa_directory_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/mobile_radio_aa_directory_enabled" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/mobile_radio_live_offset_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/mobile_radio_live_offset_enabled" />
            </LinearLayout>

            <TextView
                android:id="@+id/mobile_radio_status"
                style="@style/TextAppearance.SmartTube.Mobile.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mobile_radio_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_radio_controls"
        app:layout_constraintWidth_max="@dimen/mobile_content_max_width" />

    <TextView
        android:id="@+id/mobile_radio_empty"
        style="@style/TextAppearance.SmartTube.Mobile.BodyLarge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/mobile_radio_empty"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_radio_controls"
        app:layout_constraintWidth_max="480dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
