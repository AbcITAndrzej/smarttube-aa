    <!-- Stage 2: mobile-only Instant Play startup/recovery. -->
    <string name="mobile_player_instant_play_section">Instant Play</string>
    <string name="mobile_player_instant_play_summary">Inteligentny start działa wyłącznie w mobilnym VOD/Shorts. Najpierw pozwala zadziałać standardowemu recovery SmartTube, a dopiero potem uruchamia bezpieczny fallback. Radio i Android Auto nie są zmieniane.</string>
    <string name="mobile_player_instant_play">Włącz inteligentny start filmu</string>
    <string name="mobile_player_instant_403_recovery">Dodatkowy fallback po przejściowym 403</string>
    <string name="mobile_player_startup_watchdog">Watchdog: ponów start, gdy player utknie przed READY</string>
    <string name="mobile_player_startup_timeout">Film nie uruchomił się w oczekiwanym czasie. Możesz spróbować ponownie.</string>

