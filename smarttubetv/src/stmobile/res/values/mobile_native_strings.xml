    <string name="mobile_aa_ready_title">Android Auto is ready</string>
    <string name="mobile_aa_ready_message">SmartTube is enabled as a media app. Reconnect the phone to the car or restart Android Auto to refresh its app list.</string>
    <string name="mobile_aa_not_ready_title">More steps are required</string>
    <string name="mobile_aa_not_ready_message">Review the status and complete the unchecked steps. Android security does not allow SmartTube to enable protected Android Auto developer options automatically.</string>
    <string name="mobile_aa_guide_title">Android Auto setup</string>
    <string name="mobile_aa_guide_text">1. Open Android Auto settings.\n2. Tap Version and permission info 10 times to enable developer settings.\n3. Open Developer settings from the menu.\n4. Enable Unknown sources.\n5. Return here and confirm both steps.\n6. Tap Add / check, then reconnect Android Auto.\n\nSmartTube cannot change these protected settings automatically.</string>
    <string name="mobile_aa_disable_title">Disable Android Auto access?</string>
    <string name="mobile_aa_disable_message">SmartTube will disappear from Android Auto after the next refresh. Phone playback and YouTube data will not be changed.</string>
    <string name="mobile_aa_disable_confirm">Disable</string>
    <string name="mobile_aa_video_section">Experimental car video</string>
    <string name="mobile_aa_video_summary">Parked mode uses the normal phone video player. While driving, SmartTube remains audio-only by default. The optional passenger mode is experimental.</string>
    <string name="mobile_aa_video_switch">Display video while driving (passenger)</string>
    <string name="mobile_aa_video_platform_note">The option never bypasses Android Auto safety restrictions. The car display remains controlled by Android Auto; video may only be presented on an allowed phone surface.</string>
    <string name="mobile_aa_video_confirm_title">Enable experimental passenger mode?</string>
    <string name="mobile_aa_video_confirm_message">Use this only for a passenger. The driver must not watch or operate video while the vehicle is moving. Android Auto can still block the image.</string>
    <string name="mobile_aa_video_confirm_enable">Enable experimentally</string>
    <string name="mobile_aa_playlists_section">Android Auto playlist layout</string>
