<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartTube.MobileNative" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mobile_primary</item>
        <item name="colorPrimaryVariant">@color/mobile_primary_variant</item>
        <item name="colorSecondary">@color/mobile_secondary</item>
        <item name="colorSurface">@color/mobile_surface</item>
        <item name="android:colorBackground">@color/mobile_background</item>
        <item name="colorOnSurface">@color/mobile_on_surface</item>
        <!-- LeanbackActivity still initializes its shared background manager. -->
        <item name="shelfBackground">@color/mobile_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/mobile_surface</item>
        <item name="android:statusBarColor">@color/mobile_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.SmartTube.Mobile.Toolbar" parent="Widget.MaterialComponents.Toolbar.Surface">
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.SmartTube.Mobile.TitleLarge</item>
    </style>

    <style name="Widget.SmartTube.Mobile.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
    </style>

    <style name="Widget.SmartTube.Mobile.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
    </style>

    <style name="Widget.SmartTube.Mobile.IconButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.SmartTube.Mobile.PlayerIconButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="iconTint">@android:color/white</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.SmartTube.Mobile.PlayerButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Widget.SmartTube.Mobile.SearchInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="ShapeAppearance.SmartTube.Mobile.Thumbnail" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="TextAppearance.SmartTube.Mobile.TitleLarge" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SmartTube.Mobile.TitleMedium" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SmartTube.Mobile.BodyLarge" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.SmartTube.Mobile.BodyMedium" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.SmartTube.Mobile.Duration" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SmartTube.Mobile.PlayerTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SmartTube.Mobile.PlayerTime" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>
</resources>
